// ── Workspace: Tasks & Notes ───────────────────────────────────────────────

model WorkspaceTask {
  id                     String    @id @default(cuid())
  title                  String
  description            String?   @db.Text
  status                 String    @default("todo")
  priority               String    @default("medium")
  pinned                 Boolean   @default(false)
  dueDate                DateTime?
  reminderAt             DateTime?

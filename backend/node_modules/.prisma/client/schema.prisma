  clickCount     Int               @default(0)
  downloadCount  Int               @default(0)
  isEvent        Boolean           @default(false)
  eventDate      DateTime?
  eventCtaLabel  String?
  eventCtaUrl    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id])
  author       User                    @relation("PublicationAuthor", fields: [authorId], references: [id])
  coverFile    GalleryFile?            @relation("PublicationCover", fields: [coverFileId], references: [id])
  attachments  PublicationAttachment[]
  engagements  PublicationEngagement[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@index([organizationId, publishedAt])
  @@map("publications")
}

model PublicationAttachment {
  id            String   @id @default(cuid())
  publicationId String
  fileId        String?
  fileName      String
  fileUrl       String
  fileSize      Int      @default(0)
  mimeType      String
  label         String?
  createdAt     DateTime @default(now())

  publication Publication  @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  file        GalleryFile? @relation(fields: [fileId], references: [id])

  @@index([publicationId])
  @@map("publication_attachments")
}

model PublicationEngagement {
  id            String         @id @default(cuid())
  publicationId String
  portalUserId  String?
  userId        String?
  activityType  EngagementType
  metadata      Json           @default("{}")
  deviceInfo    String?
  createdAt     DateTime       @default(now())

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@index([publicationId, activityType])
  @@index([publicationId, portalUserId])
  @@index([publicationId, createdAt])
  @@map("publication_engagements")
}

// ── Workspace Extensions ──────────────────────────────────────────────────────

model WorkspaceSubtask {
  id           String    @id @default(cuid())
  taskId       String
  title        String
  isDone       Boolean   @default(false)
  assignedToId String?
  dueDate      DateTime?
  order        Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  task       WorkspaceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignedTo User?         @relation("SubtaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@map("workspace_subtasks")
}

model WorkspaceChecklist {
  id        String   @id @default(cuid())
  taskId    String
  title     String   @default("Checklist")
  order     Int      @default(0)
  createdAt DateTime @default(now())

  task  WorkspaceTask            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  items WorkspaceChecklistItem[]

  @@index([taskId])
  @@map("workspace_checklists")
}

model WorkspaceChecklistItem {
  id          String   @id @default(cuid())
  checklistId String
  title       String
  isDone      Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  checklist WorkspaceChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
  @@map("workspace_checklist_items")
}

model WorkspaceTaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   WorkspaceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User          @relation("TaskCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("workspace_task_comments")
}

model WorkspaceTaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  uploadedById String
  fileName     String
  originalName String
  fileUrl      String
  mimeType     String
  fileSize     Int      @default(0)
  createdAt    DateTime @default(now())

  task       WorkspaceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User          @relation("TaskAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("workspace_task_attachments")
}

// ── Settings: SMTP & API Keys ─────────────────────────────────────────────────

model SmtpSettings {
  id             String   @id @default(cuid())
  organizationId String   @unique
  host           String
  port           Int      @default(587)
  username       String
  password       String   @db.Text
  fromName       String
  fromEmail      String
  secure         Boolean  @default(false)
  isVerified     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("smtp_settings")
}

model ApiKey {
  id             String    @id @default(cuid())
  name           String
  keyHash        String    @unique
  keyPrefix      String
  userId         String
  organizationId String
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([keyHash])
  @@index([userId])
  @@index([organizationId])
  @@map("api_keys")
}

// ── Request Engine ────────────────────────────────────────────────────────────

model RequestType {
  id             String   @id @default(cuid())
  name           String
  description    String?
  icon           String   @default("FileText")
  color          String   @default("#3b82f6")
  prefix         String   @default("REQ")
  isActive       Boolean  @default(true)
  fields         Json     @default("[]") // custom field definitions for this type
  blueprintId    String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  blueprint    RequestBlueprint? @relation(fields: [blueprintId], references: [id], onDelete: SetNull)
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requests     Request[]

  @@index([organizationId])
  @@map("request_types")
}

model Request {
  id                String    @id @default(cuid())
  requestNumber     String
  typeId            String
  title             String
  description       String?   @db.Text
  priority          String    @default("MEDIUM")
  status            String    @default("OPEN")
  currentStage      String?
  currentStageId    String?
  requesterId       String
  assignedUserId    String?
  assignedDeptId    String?
  relatedEntityType String?
  relatedEntityId   String?
  data              Json      @default("{}")
  dueDate           DateTime?
  completedAt       DateTime?
  organizationId    String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  type            RequestType            @relation(fields: [typeId], references: [id])
  requester       User                   @relation("RequestCreator", fields: [requesterId], references: [id])
  assignedUser    User?                  @relation("RequestAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignedDept    Department?            @relation("RequestDepartment", fields: [assignedDeptId], references: [id], onDelete: SetNull)
  currentStageRef RequestBlueprintStage? @relation("RequestCurrentStage", fields: [currentStageId], references: [id], onDelete: SetNull)
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  comments        RequestComment[]
  attachments     RequestAttachment[]
  events          RequestEvent[]
  instance        RequestInstance?

  @@index([organizationId])
  @@index([requesterId])
  @@index([assignedUserId])
  @@index([status])
  @@index([currentStageId])
  @@map("requests")
}

model RequestBlueprint {
  id             String   @id @default(cuid())
  name           String
  description    String?
  isActive       Boolean  @default(true)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages       RequestBlueprintStage[]
  types        RequestType[]
  instances    RequestInstance[]

  @@index([organizationId])
  @@map("request_blueprints")
}

model RequestBlueprintStage {
  id              String   @id @default(cuid())
  blueprintId     String
  name            String
  description     String?
  order           Int      @default(0)
  stageType       String   @default("normal")
  color           String   @default("#3b82f6")
  responsibleRole String?
  requiredFields  Json?
  requiredDocs    Json?
  slaDuration     Int?
  notifyOnEnter   Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  blueprint       RequestBlueprint         @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  actions         RequestBlueprintAction[]
  currentRequests Request[]                @relation("RequestCurrentStage")
  instanceSteps   RequestInstanceStep[]

  @@index([blueprintId])
  @@map("request_blueprint_stages")
}

model RequestBlueprintAction {
  id            String   @id @default(cuid())
  stageId       String
  name          String
  label         String
  actionType    String   @default("custom")
  targetStageId String?
  color         String   @default("#3b82f6")
  requiresNote  Boolean  @default(false)
  conditions    Json?
  order         Int      @default(0)
  createdAt     DateTime @default(now())

  stage RequestBlueprintStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@index([stageId])
  @@map("request_blueprint_actions")
}

model RequestInstance {
  id             String    @id @default(cuid())
  blueprintId    String
  requestId      String    @unique
  currentStageId String?
  organizationId String
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  blueprint RequestBlueprint      @relation(fields: [blueprintId], references: [id])
  request   Request               @relation(fields: [requestId], references: [id], onDelete: Cascade)
  steps     RequestInstanceStep[]

  @@index([blueprintId])
  @@map("request_instances")
}

model RequestInstanceStep {
  id          String    @id @default(cuid())
  instanceId  String
  stageId     String?
  stageName   String
  actorId     String?
  actionName  String?
  actionLabel String?
  note        String?   @db.Text
  stepStatus  String    @default("completed")
  enteredAt   DateTime  @default(now())
  completedAt DateTime?

  instance RequestInstance        @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stage    RequestBlueprintStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  actor    User?                  @relation("RequestStepActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([instanceId])
  @@map("request_instance_steps")
}

model RequestComment {
  id        String   @id @default(cuid())
  requestId String
  authorId  String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User    @relation("RequestCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("request_comments")
}

model RequestAttachment {
  id         String   @id @default(cuid())
  requestId  String
  uploaderId String
  name       String
  url        String
  size       Int?
  mimeType   String?
  createdAt  DateTime @default(now())

  request  Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  uploader User    @relation("RequestAttachmentUploader", fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("request_attachments")
}

model RequestEvent {
  id        String   @id @default(cuid())
  requestId String
  actorId   String?
  eventType String
  title     String
  data      Json?
  createdAt DateTime @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User?   @relation("RequestEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@map("request_events")
}

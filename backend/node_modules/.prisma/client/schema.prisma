  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("direct_messages")
}

model Tracker {
  id                  String   @id @default(cuid())
  organizationId      String
  name                String
  description         String?
  moduleId            String
  scoreLabel          String   @default("Total Score")
  formula             String   @default("percentage") // "percentage" | "sum" | "average"
  scoreFieldId        String?
  benchmarkScore      Float?
  performanceMessages Json?
  isPublic            Boolean  @default(true)
  sharedUsers         Json     @default("[]")
  sharedDepts         Json     @default("[]")
  createdById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  isActive            Boolean  @default(true)

  organization Organization      @relation(fields: [organizationId], references: [id])
  module       DynamicModule     @relation(fields: [moduleId], references: [id])
  createdBy    User?             @relation("TrackerCreator", fields: [createdById], references: [id])
  criteria     TrackerCriteria[]
  sessions     TrackerSession[]
  scores       TrackerScore[]
  bands        TrackerBand[]

  @@index([organizationId])
  @@map("trackers")
}

model TrackerBand {
  id        String @id @default(cuid())
  trackerId String
  name      String
  color     String @default("#6b7280")
  minVal    Float  @default(0)
  maxVal    Float  @default(100)
  order     Int    @default(0)

  tracker Tracker @relation(fields: [trackerId], references: [id], onDelete: Cascade)

  @@index([trackerId])
  @@map("tracker_bands")
}

model TrackerCriteria {
  id          String   @id @default(cuid())
  trackerId   String
  name        String
  description String?
  scoreType   String   @default("points") // "points" | "rating" | "percentage"
  minValue    Int      @default(0)
  maxPoints   Int      @default(10)
  weight      Float    @default(0) // % weight for scoreType=percentage (0-100)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  tracker Tracker        @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  scores  TrackerScore[]

  @@index([trackerId])
  @@map("tracker_criteria")
}

model TrackerSession {
  id        String   @id @default(cuid())
  trackerId String
  label     String
  date      DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())

  tracker Tracker        @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  scores  TrackerScore[]

  @@index([trackerId])
  @@map("tracker_sessions")
}

model TrackerScore {
  id         String   @id @default(cuid())
  trackerId  String
  sessionId  String
  criteriaId String
  recordId   String
  score      Float?
  note       String?
  updatedAt  DateTime @updatedAt

  tracker  Tracker         @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  session  TrackerSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  criteria TrackerCriteria @relation(fields: [criteriaId], references: [id], onDelete: Cascade)

  @@unique([sessionId, criteriaId, recordId])
  @@index([sessionId, recordId])
  @@index([trackerId, recordId])
  @@map("tracker_scores")
}


// ── Scheduled Configuration Engine ──────────────────────────────────────────────
// Schedules a future CONFIG change (a field's default value, a dropdown's options, a
// saved filter's conditions, a workflow's on/off state) to apply automatically at a
// future date/time — one-time or on a simple Daily/Weekly/Monthly repeat. Deliberately
// avoids a full cron-expression engine (nothing else in this codebase has one either —
// even Blueprint's own 'cron' transition mode is left unimplemented on purpose, per its
// own comment, to avoid silent misfires) in favor of the same explicit polling pattern
// already used by BlueprintScheduledTransition/WorkflowScheduleLog: a 5-minute @Cron job
// finds rows whose `nextRunAt` has passed and executes them.
model ScheduledConfiguration {
  id             String   @id @default(cuid())
  name           String
  description    String?
  organizationId String
  createdById    String

  isActive    Boolean @default(true) // pause/resume; a one-time config also flips this off once it has fired
  isRecurring Boolean @default(false)

  // Recurrence — only meaningful when isRecurring; kept to three simple patterns rather
  // than a cron expression (see file-level comment above).
  recurrencePattern    String? // 'DAILY' | 'WEEKLY' | 'MONTHLY'
  recurrenceDayOfWeek  Int?    // 0 (Sun) - 6 (Sat), WEEKLY only
  recurrenceDayOfMonth Int?    // 1-31, MONTHLY only
  timeOfDay            String  // "HH:MM", 24h — the time-of-day component for every mode

  runAt     DateTime? // one-time only: the exact date+time originally picked (kept for display even after nextRunAt advances)
  nextRunAt DateTime  // what the scheduler polls against — always populated
  lastRunAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization                @relation(fields: [organizationId], references: [id])
  createdBy     User                        @relation(fields: [createdById], references: [id])
  actions       ConfigurationAction[]
  executionLogs ConfigurationExecutionLog[]

  @@index([organizationId])
  @@index([nextRunAt, isActive])
  @@map("scheduled_configurations")
}

// One config change to apply when the parent fires. `targetId` is a Field id, SavedFilter
// id, or Workflow id depending on `type`; `config` carries the actual new value(s) — see
// ScheduledConfigurationsService.executeAction for the exact shape expected per type.
model ConfigurationAction {
  id                       String   @id @default(cuid())
  scheduledConfigurationId String
  type                     String   // 'SET_FIELD_DEFAULT' | 'UPDATE_FIELD_OPTIONS' | 'UPDATE_SAVED_FILTER' | 'SET_WORKFLOW_ACTIVE'
  targetId                 String
  config                   Json     @default("{}")
  order                    Int      @default(0)
  createdAt                DateTime @default(now())

  scheduledConfiguration ScheduledConfiguration @relation(fields: [scheduledConfigurationId], references: [id], onDelete: Cascade)

  @@index([scheduledConfigurationId])
  @@map("configuration_actions")
}

// One row per firing — this table IS the execution history the builder UI shows, the same
// convention as BlueprintScheduledTransition's own executed/cancelled flags rather than
// routing through the generic AuditLog (a summary AuditLog entry is still written
// alongside, for the org-wide audit trail).
model ConfigurationExecutionLog {
  id                       String   @id @default(cuid())
  scheduledConfigurationId String
  organizationId           String
  status                   String   // 'success' | 'partial' | 'failed'
  ranAt                    DateTime @default(now())
  details                  Json     @default("[]") // [{ actionId, type, targetId, status, error? }]
  errorMessage             String?

  scheduledConfiguration ScheduledConfiguration @relation(fields: [scheduledConfigurationId], references: [id], onDelete: Cascade)

  @@index([scheduledConfigurationId])
  @@index([organizationId])
  @@map("configuration_execution_logs")
}


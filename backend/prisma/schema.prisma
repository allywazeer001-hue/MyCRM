// Singleton row (fixed id "global") — a platform-wide announcement banner shown
// on every page, configured from /land-admin. Not tied to an organization since
// it announces changes to the platform itself, not org-specific data.
model PlatformAnnouncement {
  id             String    @id @default("global")
  message        String    @db.Text
  isActive       Boolean   @default(false)
  // Optional schedule — when set, the banner (while isActive) only shows within
  // this date range, and only during this time-of-day window on each day in it.
  // Any of these left null means "no restriction" on that dimension.
  startDate      DateTime?
  endDate        DateTime?
  dailyStartTime String?   // "HH:MM", server-local time
  dailyEndTime   String?   // "HH:MM", server-local time
  updatedAt      DateTime  @updatedAt

  @@map("platform_announcements")
}


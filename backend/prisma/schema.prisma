model Tracker {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  moduleId       String
  scoreLabel     String   @default("Total Score")
  formula        String   @default("percentage")  // "percentage" | "sum" | "average"
  scoreFieldId        String?

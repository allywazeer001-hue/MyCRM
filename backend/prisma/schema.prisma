// A folder groups SavedReports for organization; access control mirrors
// Dashboard (isPublic + sharedRoles/Departments/Users), enforced via the
// shared PermissionCheckService.canViewResource/enforceCanEditResource.
model ReportFolder {
  id                String   @id @default(cuid())
  name              String
  organizationId    String
  createdById       String
  isPublic          Boolean  @default(false)
  sharedRoles       Json     @default("[]")
  sharedDepartments Json     @default("[]")
  sharedUsers       Json     @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  reports      SavedReport[]

  @@index([organizationId])
  @@map("report_folders")
}

// ── Workspace: Tasks & Notes ───────────────────────────────────────────────

model WorkspaceTask {
  id                      String    @id @default(cuid())
  title                   String
  description             String?   @db.Text
  status                  String    @default("todo")
  priority                String    @default("medium")
  pinned                  Boolean   @default(false)
  dueDate                 DateTime?
  reminderAt              DateTime?
  assignedToId            String?
  assignedById            String
  departmentId            String?
  organizationId          String
  linkedRecordId          String?
  linkedModuleId          String?
  autoCompleteOnSubtasks  Boolean   @default(false)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  assignedTo   User?        @relation("WorkspaceTaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedBy   User         @relation("WorkspaceTaskCreator",  fields: [assignedById],  references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subtasks     WorkspaceSubtask[]
  checklists   WorkspaceChecklist[]
  comments     WorkspaceTaskComment[]
  attachments  WorkspaceTaskAttachment[]

  @@index([organizationId])
  @@index([assignedToId])
  @@index([assignedById])
  @@index([departmentId])
  @@index([dueDate])
  @@index([linkedRecordId])
  @@map("workspace_tasks")
}

// ── Calendar Sync ─────────────────────────────────────────────────────────────


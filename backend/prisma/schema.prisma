  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([keyHash])
  @@index([userId])
  @@index([organizationId])
  @@map("api_keys")
}

// ── Connected Applications (Phase 1: foundation, approval flow, OAuth tokens) ──
// External apps (Inventory, HR, Finance, etc.) request access to an org's CRM
// data. An admin reviews and approves/rejects in Settings > Connected
// Applications. Approval mints a ConnectedApp (OAuth-style client) with
// per-module/scope access levels. Token issuance follows a standard
// authorization-code exchange (see ConnectedAppAuthCode/ConnectedAppToken)
// so the client secret is only ever shown once, at approval time.

enum ConnectionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConnectedAppStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum ScopeAccess {
  DENY
  READ_ONLY
  READ_WRITE
}

model ConnectionRequest {
  id               String                  @id @default(cuid())
  organizationId   String
  appName          String
  appUrl           String
  appLogoUrl       String?
  developerName    String
  developerEmail   String?
  requestedScopes  Json                    // string[] of scope keys requested by the app
  redirectUrl      String
  publicKey        String?                 @db.Text
  status           ConnectionRequestStatus @default(PENDING)
  reviewedByUserId String?
  reviewedAt       DateTime?
  rejectionReason  String?
  connectedAppId   String?                 @unique
  createdAt        DateTime                @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedApp ConnectedApp? @relation(fields: [connectedAppId], references: [id])

  @@index([organizationId, status])
  @@map("connection_requests")
}

model ConnectedApp {
  id                 String             @id @default(cuid())
  organizationId     String
  name               String
  logoUrl            String?
  developerName      String
  redirectUrl        String
  publicKey          String?            @db.Text
  clientId           String             @unique
  clientSecretHash   String
  // Real-time sync target: set by the CRM admin from values generated on the
  // external app's own side (e.g. Inventory's Sync Settings screen) — see
  // ConnectedAppsService.updateWebhookConfig. Not the OAuth redirectUrl.
  webhookUrl         String?
  // AES-256-GCM ciphertext of the webhook signing secret pasted in alongside
  // webhookUrl — decrypted only at delivery time to compute the outgoing
  // HMAC-SHA256 signature (WebhookDispatchService), never re-displayed.
  webhookSecretEnc   String?
  status             ConnectedAppStatus @default(ACTIVE)
  connectedAt        DateTime           @default(now())
  lastSyncAt         DateTime?
  lastApiCallAt      DateTime?
  lastTokenRefreshAt DateTime?
  createdByUserId    String
  // Optional IP allowlist (stored now, enforced once the public API gateway exists).
  ipAllowlist        Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectionRequest ConnectionRequest?
  scopes            ConnectedAppScope[]
  authCodes         ConnectedAppAuthCode[]
  tokens            ConnectedAppToken[]

  @@index([organizationId])
  @@map("connected_apps")
}

model ConnectedAppScope {
  id             String      @id @default(cuid())
  connectedAppId String
  scopeKey       String      // e.g. "module:<moduleId>", "reports:read", "files:read", "forms:read"
  access         ScopeAccess @default(DENY)

  connectedApp ConnectedApp @relation(fields: [connectedAppId], references: [id], onDelete: Cascade)

  @@unique([connectedAppId, scopeKey])
  @@map("connected_app_scopes")
}

model ConnectedAppAuthCode {
  id             String    @id @default(cuid())
  connectedAppId String
  codeHash       String
  codePrefix     String
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())
  // Populated only by the pairing-code flow (approveRequest) — AES-256-GCM
  // ciphertext of the raw client secret, decrypted back at redemption time
  // (POST /connected-apps/pair) so the caller gets full credentials in one
  // shot. Rows from the older long-opaque-code flow leave this null, which
  // is also how redeemPairingCode tells the two kinds of rows apart.
  clientSecretEnc String?  @db.Text
  // Failed bcrypt-compare attempts against this specific row, via the
  // pairing-code flow's weak codePrefix pre-filter. Capped at
  // PAIRING_CODE_MAX_ATTEMPTS in ConnectedAppsService, after which the row
  // self-invalidates (usedAt gets set) rather than staying guessable.
  failedAttempts  Int      @default(0)

  connectedApp ConnectedApp @relation(fields: [connectedAppId], references: [id], onDelete: Cascade)

  @@index([codePrefix])
  @@index([connectedAppId])
  @@map("connected_app_auth_codes")
}

model ConnectedAppToken {
  id                String    @id @default(cuid())
  connectedAppId    String
  accessTokenJti    String    @unique
  refreshTokenHash  String
  refreshTokenPrefix String
  accessExpiresAt   DateTime
  refreshExpiresAt  DateTime
  revokedAt         DateTime?
  rotatedFromId     String?   @unique
  createdAt         DateTime  @default(now())

  connectedApp  ConnectedApp       @relation(fields: [connectedAppId], references: [id], onDelete: Cascade)
  rotatedFrom   ConnectedAppToken? @relation("TokenRotation", fields: [rotatedFromId], references: [id])
  rotatedInto   ConnectedAppToken? @relation("TokenRotation")

  @@index([connectedAppId])
  @@index([refreshTokenPrefix])
  @@map("connected_app_tokens")
}

// ── Request Engine ────────────────────────────────────────────────────────────

model RequestType {
  id             String   @id @default(cuid())
  name           String
  description    String?
  icon           String   @default("FileText")
  color          String   @default("#3b82f6")
  prefix         String   @default("REQ")
  isActive       Boolean  @default(true)
  fields         Json     @default("[]")  // custom field definitions for this type
  blueprintId    String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  blueprint    RequestBlueprint? @relation(fields: [blueprintId], references: [id], onDelete: SetNull)
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requests     Request[]

  @@index([organizationId])
  @@map("request_types")
}

model Request {
  id                String    @id @default(cuid())
  requestNumber     String
  typeId            String
  title             String
  description       String?   @db.Text
  priority          String    @default("MEDIUM")
  status            String    @default("OPEN")
  currentStage      String?
  currentStageId    String?
  requesterId       String
  assignedUserId    String?
  assignedDeptId    String?
  relatedEntityType String?
  relatedEntityId   String?
  data              Json      @default("{}")
  dueDate           DateTime?
  completedAt       DateTime?
  organizationId    String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  type         RequestType          @relation(fields: [typeId], references: [id])
  requester    User                 @relation("RequestCreator",  fields: [requesterId],   references: [id])
  assignedUser User?                @relation("RequestAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignedDept Department?          @relation("RequestDepartment", fields: [assignedDeptId], references: [id], onDelete: SetNull)
  currentStageRef RequestBlueprintStage? @relation("RequestCurrentStage", fields: [currentStageId], references: [id], onDelete: SetNull)
  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  comments     RequestComment[]
  attachments  RequestAttachment[]
  events       RequestEvent[]
  instance     RequestInstance?

  @@index([organizationId])
  @@index([requesterId])
  @@index([assignedUserId])
  @@index([status])
  @@index([currentStageId])
  @@map("requests")
}

model RequestBlueprint {
  id             String   @id @default(cuid())
  name           String
  description    String?
  isActive       Boolean  @default(true)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages       RequestBlueprintStage[]
  types        RequestType[]
  instances    RequestInstance[]

  @@index([organizationId])
  @@map("request_blueprints")
}

model RequestBlueprintStage {
  id              String   @id @default(cuid())
  blueprintId     String
  name            String
  description     String?
  order           Int      @default(0)
  stageType       String   @default("normal")
  color           String   @default("#3b82f6")
  responsibleRole String?
  requiredFields  Json?
  requiredDocs    Json?
  slaDuration     Int?
  notifyOnEnter   Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  blueprint       RequestBlueprint       @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  actions         RequestBlueprintAction[]
  currentRequests Request[]              @relation("RequestCurrentStage")
  instanceSteps   RequestInstanceStep[]

  @@index([blueprintId])
  @@map("request_blueprint_stages")
}

model RequestBlueprintAction {
  id            String   @id @default(cuid())
  stageId       String
  name          String
  label         String
  actionType    String   @default("custom")
  targetStageId String?
  color         String   @default("#3b82f6")
  requiresNote  Boolean  @default(false)
  conditions    Json?
  order         Int      @default(0)
  createdAt     DateTime @default(now())

  stage RequestBlueprintStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@index([stageId])
  @@map("request_blueprint_actions")
}

model RequestInstance {
  id             String    @id @default(cuid())
  blueprintId    String
  requestId      String    @unique
  currentStageId String?
  organizationId String
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  blueprint RequestBlueprint     @relation(fields: [blueprintId], references: [id])
  request   Request              @relation(fields: [requestId], references: [id], onDelete: Cascade)
  steps     RequestInstanceStep[]

  @@index([blueprintId])
  @@map("request_instances")
}

model RequestInstanceStep {
  id          String    @id @default(cuid())
  instanceId  String
  stageId     String?
  stageName   String
  actorId     String?
  actionName  String?
  actionLabel String?
  note        String?   @db.Text
  stepStatus  String    @default("completed")
  enteredAt   DateTime  @default(now())
  completedAt DateTime?

  instance RequestInstance        @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stage    RequestBlueprintStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  actor    User?                  @relation("RequestStepActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([instanceId])
  @@map("request_instance_steps")
}

model RequestComment {
  id        String   @id @default(cuid())
  requestId String
  authorId  String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User    @relation("RequestCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("request_comments")
}

model RequestAttachment {
  id         String   @id @default(cuid())
  requestId  String
  uploaderId String
  name       String
  url        String
  size       Int?
  mimeType   String?
  createdAt  DateTime @default(now())

  request  Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  uploader User    @relation("RequestAttachmentUploader", fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("request_attachments")
}

model RequestEvent {
  id        String   @id @default(cuid())
  requestId String
  actorId   String?
  eventType String
  title     String
  data      Json?
  createdAt DateTime @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User?   @relation("RequestEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@map("request_events")
}

// ── Email ─────────────────────────────────────────────────────────────────────

model EmailTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  subject        String
  body           String   @db.LongText
  design         String?  @db.LongText
  isActive       Boolean  @default(true)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation("OrgEmailTemplates", fields: [organizationId], references: [id])
  createdBy    User         @relation("EmailTemplateCreator", fields: [createdById], references: [id])
  emailLogs    EmailLog[]

  @@index([organizationId])
  @@map("email_templates")
}

model EmailLog {
  id             String   @id @default(cuid())
  organizationId String
  templateId     String?
  sentById       String
  // Optional — which record this email was about, so a record's detail page can
  // show its own email history. Plain string (no relation) since records live in
  // a dynamic per-module table, not a single typed model.
  recordId       String?
  // Groups every recipient of one "send" call into a single campaign/report row —
  // one batchId per compose-and-send action, shared across all its recipients.
  batchId        String?
  toEmail        String
  toName         String?
  subject        String
  body           String   @db.LongText
  replyTo        String?
  // Free-text note a user can attach (e.g. to a batch of unopened emails) —
  // shown alongside this email on the record's own Emails tab, for follow-up tracking.
  remark         String?  @db.Text
  status         String   @default("sent") // sent | failed | bounced
  errorMsg       String?
  openedAt       DateTime?
  clickedAt      DateTime?
  sentAt         DateTime @default(now())

  organization Organization   @relation("OrgEmailLogs", fields: [organizationId], references: [id])
  sentBy       User            @relation("EmailLogSender", fields: [sentById], references: [id])
  template     EmailTemplate?  @relation(fields: [templateId], references: [id])

  @@index([organizationId])
  @@index([sentById])
  @@index([batchId])
  @@index([recordId])
  @@map("email_logs")
}

// A compose-and-send action deferred to a future time. A cron job picks up rows
// where sendAt <= now and status = 'pending', sends them the same way an
// immediate send works, then marks them 'sent' (or 'failed' on an error before
// any recipient attempt, e.g. template lookup failure).
model ScheduledEmail {
  id             String    @id @default(cuid())
  organizationId String
  sentById       String
  recipients     Json      // Recipient[] snapshot — email/name/mergeData/recordId per person
  subject        String
  body           String    @db.LongText
  templateId     String?
  replyTo        String?
  sendAt         DateTime
  status         String    @default("pending") // pending | sent | cancelled | failed
  errorMsg       String?
  createdAt      DateTime  @default(now())
  sentAt         DateTime?

  organization Organization @relation("OrgScheduledEmails", fields: [organizationId], references: [id])
  sentBy       User         @relation("ScheduledEmailSender", fields: [sentById], references: [id])

  @@index([organizationId])
  @@index([status, sendAt])
  @@map("scheduled_emails")
}

model RecordRoutingConfig {
  id               String    @id @default(cuid())
  name             String
  description      String?
  moduleId         String
  organizationId   String
  isEnabled        Boolean   @default(true)
  priority         Int       @default(0)
  targetRoles      Json      @default("[]")
  filterConditions Json      @default("[]")
  conditionsLogic  String    @default("AND")
  displayFields    Json      @default("[]")
  actions          Json      @default("[]")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([moduleId, organizationId])
  @@map("record_routing_configs")
}

// ── Data Quality Models ───────────────────────────────────────────────────────

model DataQualityConfig {
  id                String   @id @default(cuid())
  organizationId    String   @unique
  autoMode          Boolean  @default(false)
  schedule          String   @default("DISABLED")
  scheduledHour     Int      @default(2)
  duplicateRules    Json     @default("[]")
  missingDataRules  Json     @default("[]")
  notifyDuplicate   Boolean  @default(true)
  notifyMissing     Boolean  @default(true)
  notifyInvalid     Boolean  @default(false)
  includedModules   Json     @default("[]")
  notifyRoles       Json     @default("[\"ADMIN\",\"SUPER_ADMIN\"]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("data_quality_configs")
}

model DataQualityScan {
  id             String    @id @default(cuid())
  organizationId String
  initiatedById  String?
  status         String    @default("RUNNING")
  scanType       String    @default("MANUAL")
  moduleId       String?
  moduleName     String?
  summary        Json      @default("{}")
  duration       Int?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  issues         DataQualityIssue[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("data_quality_scans")
}

model DataQualityIssue {
  id             String    @id @default(cuid())
  scanId         String
  scan           DataQualityScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  organizationId String
  issueType      String
  severity       String    @default("MEDIUM")
  moduleId       String
  moduleName     String    @default("")
  moduleSlug     String    @default("")
  recordId       String
  fieldName      String?
  details        Json      @default("{}")
  isResolved     Boolean   @default(false)
  resolvedAt     DateTime?
  resolvedById   String?
  createdAt      DateTime  @default(now())

  @@index([scanId])
  @@index([organizationId])
  @@index([moduleId])
  @@index([recordId])
  @@map("data_quality_issues")
}

model WorkflowScheduleLog {
  id         String   @id @default(cuid())
  workflowId String
  triggerKey String
  executedAt DateTime @default(now())

  @@unique([workflowId, triggerKey])
  @@index([workflowId])
  @@map("workflow_schedule_logs")
}

